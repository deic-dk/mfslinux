#!/bin/bash

# Use the first two disks found
disks=`ls /dev | grep -E 'sd[^0-9]$' | head -2`
nvmes=`ls /dev | grep -E 'nvme0n[0-9]$' | head -2`

# A disk that carries our CONTAINERS label is container storage (see below), not a
# system or backup disk - also when it is the second disk of the machine. That is how a
# node with a small root SSD and one big data disk keeps /var/lib/containers on the big
# disk across reinstalls: label it once (mkfs.xfs -L CONTAINERS) and the installer
# leaves the backup-root scheme aside for it.
disks=`for d in $disks; do [ "\`lsblk -dn -o LABEL /dev/$d 2>/dev/null | xargs\`" = CONTAINERS ] || echo $d; done`
nvmes=`for d in $nvmes; do [ "\`lsblk -dn -o LABEL /dev/$d 2>/dev/null | xargs\`" = CONTAINERS ] || echo $d; done`

numdisks=`echo $disks $nvmes| wc -w`
firstdisk=`echo "${nvmes[0]} ${disks[0]}" | head -1 | xargs`

root_part_label=ROOT
swap_part_label=SWAP

tmp_root_part_label=$root_part_label
tmp_swap_part_label=$swap_part_label

for disk in $nvmes $disks; do

	p=""
	echo $disk | grep nvme >& /dev/null
	if [ "$?" -eq 0 ]; then
		p="p"
	fi

	# Destroy any existing partitions
	dd if=/dev/zero of=/dev/$disk bs=4M count=1
	
	# Create MBR partitions: 16G swap and one Linux partition on the rest
	printf "o\nn\np\n1\n\n+16G\nt\n82\nn\np\n2\n\n\nw\n" | fdisk "/dev/$disk"
	
	# Make the boot partition bootable
	printf "a\n2\nw\n"  | fdisk "/dev/$disk"
	
	# Format swap partition
	mkswap -L $tmp_swap_part_label /dev/${disk}${p}1
	
	# Format root partition
	echo y | mkfs.ext4 /dev/${disk}${p}2
	
	# Make sure partitions are labelled
	tune2fs -L $tmp_root_part_label /dev/${disk}${p}2

	# Make sure partitions on backup disk have different labels
	tmp_swap_part_label=${swap_part_label}_bk
	tmp_root_part_label=${tmp_root_part_label}_bk
	
done

# Mount active system partition at /mnt
mount -t ext4 /dev/${firstdisk}${p}2 /mnt

# Add entries to fstab
mkdir /mnt/etc
echo "# Device	Mountpoint	FStype	Options	Dump	Pass#" > /mnt/etc/fstab
echo "LABEL=$swap_part_label	none	swap	sw	0	0" >> /mnt/etc/fstab
echo "LABEL=$root_part_label	/	ext4	rw	0	1" >> /mnt/etc/fstab
echo "proc	/proc	proc	defaults	0	0" >> /mnt/etc/fstab

# Container storage on a disk of its own, if the machine has one beyond the two
# system disks: CRI-O's /var/lib/containers holds the pulled images and every
# container's writable layer (what user pods write outside their volumes). On the
# root disk, a few large images plus a busy pod push the node under the kubelet's
# disk-pressure threshold and pods get evicted. On its own filesystem it is the
# kubelet's "imagefs", with its own threshold, and the root disk keeps its room.
# Only a disk that is blank, or that already carries our CONTAINERS label from a
# previous install, is used - a disk with anything else on it is left alone.
for disk in `lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}' | grep -E '^(sd[a-z]+|nvme[0-9]+n[0-9]+)$'`; do
	# skip the two system disks ($disks/$nvmes are newline-separated: let the shell split them)
	case " `echo $disks $nvmes` " in *" $disk "*) continue;; esac
	label=`lsblk -dn -o LABEL /dev/$disk | xargs`
	fstype=`lsblk -dn -o FSTYPE /dev/$disk | xargs`
	parts=`lsblk -n -o NAME /dev/$disk | tail -n +2 | wc -l`
	if [ "$label" = "CONTAINERS" ] || [ -z "$fstype" -a "$parts" -eq 0 ]; then
		echo "Using /dev/$disk for /var/lib/containers"
		mkfs.xfs -f -L CONTAINERS /dev/$disk
		mkdir -p /mnt/var/lib/containers
		mount -t xfs /dev/$disk /mnt/var/lib/containers
		echo "LABEL=CONTAINERS	/var/lib/containers	xfs	defaults,noatime,nofail	0	2" >> /mnt/etc/fstab
		break
	fi
done

if [ $numdisks -gt 1 ]; then

	seconddisk=`echo "${nvmes[0]} ${disks[0]}" | head -2 | tail -1`
	
	p=""
	echo $seconddisk | grep nvme >& /dev/null
	if [ "$?" -eq 0 ]; then
		p="p"
	fi

	# Mount backup system partition at /bk
	mkdir /bk
	mount -t ext4 /dev/${seconddisk}${p}2 /bk

	# Add entries to fstab backup $PATH_FSTAB
	mkdir /bk/etc
	echo "# Device Mountpoint FStype Options Dump Pass#" > /bk/etc/fstab
	echo "LABEL=${swap_part_label}_bk none swap sw 0 0" >> /bk/etc/fstab
	echo "LABEL=${root_part_label}_bk / ext4 rw 1 1" >> /bk/etc/fstab
	echo "proc /proc proc defaults 0 0" >> /bk/etc/fstab
	
	# Unmount backup partition
	umount /bk
	rmdir /bk

fi

